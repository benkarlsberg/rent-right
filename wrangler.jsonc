{
  "name": "rent-right",
  "main": "cloudflare-worker.ts",
  "triggers": {
    "crons": ["0 16 * * *"]
  },
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "placement": { "region": "aws:us-east-1" },
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
