{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "channel": "development",
      "node": "22.14.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.rentrightportal.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "22.14.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.rentrightportal.com",
        "EXPO_PUBLIC_APPLE_AUTH": "1",
        "EXPO_PUBLIC_GOOGLE_AUTH": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "node": "22.14.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.rentrightportal.com",
        "EXPO_PUBLIC_APPLE_AUTH": "1",
        "EXPO_PUBLIC_GOOGLE_AUTH": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "B5RNR69S8U",
        "ascAppId": "6827279336"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
