{
  "expo": {
    "name": "Rent Right",
    "slug": "rent-right",
    "scheme": "rentright",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f6f5f2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "local.rentright.app"
    },
    "android": {
      "package": "local.rentright.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f5c4c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        { "photosPermission": "Rent Right attaches photos to your condition report." }
      ]
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing"
    ]
  }
}
