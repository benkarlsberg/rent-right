{
  "expo": {
    "name": "Rent Right",
    "slug": "rent-right",
    "scheme": "rentright",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAF9",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAF9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "local.rentright.app"
    },
    "android": {
      "package": "local.rentright.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAF9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Rent Right",
      "shortName": "Rent Right",
      "themeColor": "#0B5C6E",
      "backgroundColor": "#F8FAF9",
      "display": "standalone",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        { "photosPermission": "Rent Right attaches photos to your condition report." }
      ]
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing"
    ]
  }
}
