{
  "expo": {
    "name": "Rent Right",
    "slug": "rent-right",
    "scheme": "rentright",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAF9",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rentrightportal.app",
      "appleTeamId": "B5RNR69S8U",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Rent Right",
        "CFBundleName": "Rent Right",
        "NSPhotoLibraryUsageDescription": "Rent Right attaches photos you choose to a condition report or a message.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.rentrightportal.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Rent Right",
      "shortName": "Rent Right",
      "themeColor": "#0B5C6E",
      "backgroundColor": "#F8FAF9",
      "display": "standalone",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAF9",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      [
        "expo-secure-store",
        { "faceIDPermission": false }
      ],
      "expo-sharing",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rent Right attaches photos you choose to a condition report or a message.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c5fc1877-2f83-482a-a8cf-146506723a60"
      }
    },
    "owner": "bkarlsberg-team"
  }
}
