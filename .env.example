# Copy to .env.local. Never commit real secrets.

# Required in production. In local dev, a documented fallback is used if these are empty.
AUTH_SECRET=
# 32-byte key, base64. Encrypts lease text, message bodies, and stored files.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_PATH=data/rent-right.sqlite

# Per-unit relay addresses look like u-1a2b3c4d@this-domain
RELAY_DOMAIN=relay.rentright.local

# Resend (https://resend.com). Leave blank to log mail locally without sending.
RESEND_API_KEY=
RESEND_FROM=Rent Right <mail@your-domain>
# Shared secret for /api/email/inbound and /api/email/webhook (Authorization: Bearer)
EMAIL_WEBHOOK_SECRET=

# Gemini paid tier (data not used for training on paid projects). Optional.
# Lease text is redacted for email, phone, and SSN-like numbers before it is sent.
GEMINI_API_KEY=
# Optional fallback if Gemini is unset.
OPENAI_API_KEY=

# Cloudflare R2. Leave blank to store encrypted files on local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Supabase. The running app uses local SQLite so it works with no cloud account.
# Apply supabase/migrations/001_init.sql when you host Postgres. These vars are
# recorded for that deploy; the server does not require them to boot.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Protects POST /api/cron/reminders
CRON_SECRET=

# Optional Web Push (VAPID). In-app and email reminders work without these.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@example.com
