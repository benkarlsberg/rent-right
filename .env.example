# Copy to .env.local. Never commit real secrets.
# GitHub Actions secret names are the same as these variable names.

# Postgres. Local Docker Compose default:
# postgres://rent:rent@127.0.0.1:5432/rent_right
# Hosted: Supabase direct or session-pooler URI for the postgres role.
DATABASE_URL=

# Required in production. In local dev, a documented fallback is used if these are empty.
AUTH_SECRET=
# 32-byte key, base64. Encrypts message bodies and stored files.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Per-unit relay addresses look like u-1a2b3c4d@this-domain
RELAY_DOMAIN=relay.rentright.local

# Resend (https://resend.com). Leave blank to log mail locally without sending.
RESEND_API_KEY=
RESEND_FROM=Rent Right <mail@your-domain>
# Shared secret for /api/email/inbound and /api/email/webhook (Authorization: Bearer)
EMAIL_WEBHOOK_SECRET=

# Gemini. Optional. Lease text is redacted before it is sent.
GEMINI_API_KEY=
# Optional fallback if Gemini is unset.
OPENAI_API_KEY=

# Cloudflare R2. Leave blank to store encrypted files on local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Supabase Auth. Leave blank to use local magic links.
# SUPABASE_URL and SUPABASE_ANON_KEY turn on Auth.
# SUPABASE_SERVICE_ROLE_KEY lets the server mint the link (recommended). Never expose it to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protects POST /api/cron/reminders
CRON_SECRET=

# Optional Web Push (VAPID). Not wired. In-app and email reminders work without these.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@example.com

# Phone app only (mobile/.env). Public URL of this API when it is not on the same machine.
# EXPO_PUBLIC_API_URL=https://rent-right.example.workers.dev
